<Window x:Class="WpfGitAppVS20._4337_Sakaev"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="4337_Sakaev" Height="550" Width="950">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ЛР №4 — Работа с данными клиентов"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,15" HorizontalAlignment="Left">
            <Button Name="btnImport"
                    Content="Импорт данных"
                    Width="150"
                    Height="40"
                    Margin="0,0,10,10"
                    Click="btnImport_Click"/>

            <Button Name="btnExport"
                    Content="Экспорт в Excel"
                    Width="150"
                    Height="40"
                    Margin="0,0,10,10"
                    Click="btnExport_Click"/>

            <Button Name="btnImportJson"
                    Content="Импорт JSON данных"
                    Width="170"
                    Height="40"
                    Margin="0,0,10,10"
                    Click="btnImportJson_Click"/>

            <Button Name="btnExportWord"
                    Content="Экспорт в Word"
                    Width="150"
                    Height="40"
                    Margin="0,0,10,10"
                    Click="btnExportWord_Click"/>
        </WrapPanel>

        <DataGrid Name="clientsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"/>
    </Grid>
</Window>